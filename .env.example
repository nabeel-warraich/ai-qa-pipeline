# Copy to .env and fill in ONE provider to enable AI mode.
# Leave everything blank to run in heuristic (no-key) mode.

# Choose: openai | anthropic | none
LLM_PROVIDER=none

# For openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
